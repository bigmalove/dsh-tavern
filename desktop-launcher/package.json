{
  "name": "dsh-tavern-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "把 DSH Tavern 的启动按钮注册进 DSH Better Sidebar：桌面 GUI 内直接启动/停止/打开 tavern 服务（profile \"tavern\"），并支持在新窗口打开酒馆界面。Host half 复用 tavern 仓库 bin/ 的既有生命周期实现，不重复实现启动逻辑。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-better-sidebar",
    "tavern",
    "launcher",
    "侧边栏",
    "启动器"
  ]
}
