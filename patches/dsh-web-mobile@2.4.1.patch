+/**
+ * DSH Tavern: the non-passive document `touchmove` guard is only installed
+ * while a stroke that genuinely needs it is live — an edge swipe, or any
+ * stroke over the open drawer. A document-level non-passive touchmove
+ * listener puts the WHOLE page into the touch-handler region, so Android
+ * WebView runs every scroll (and its start) through JS, and the first
+ * preventDefault inside it cancels the gesture for the rest of the touch
+ * sequence. Measured symptom on a phone: the conversation "slides slowly and
+ * cannot be flicked". Reading drags start outside the edge strip, where
+ * `touch-action: pan-y` already forbids the horizontal claim, so nothing is
+ * lost by leaving them entirely to the browser.
+ */
+let scrollClaimHandler = null;
+let scrollClaimAttached = false;
+function attachScrollClaim() {
+    if (scrollClaimAttached || scrollClaimHandler === null) return;
+    scrollClaimAttached = true;
+    document.addEventListener('touchmove', scrollClaimHandler, { capture: true, passive: false });
+}
+function detachScrollClaim() {
+    if (!scrollClaimAttached) return;
+    scrollClaimAttached = false;
+    document.removeEventListener('touchmove', scrollClaimHandler, { capture: true });
+}
+/** Distance from the physical edge that still arms the scroll guard. */
+const EDGE_CLAIM_PX = 32;
+function insideEdgeClaim(x, viewportWidthPx, rtl) {
+    const edge = rtl ? viewportWidthPx - x : x;
+    return edge >= 0 && edge <= EDGE_CLAIM_PX;
+}
