+/**
+ * DSH Tavern: the document-level non-passive `touchmove` guard is only installed
+ * while a stroke that genuinely needs it is live. A standing listener puts the
+ * whole page into the touch-handler region, so Android WebView routes every
+ * scroll (and its start) through JS, and the first preventDefault inside it
+ * cancels that gesture for the rest of the sequence — measured on a phone as
+ * "the conversation slides slowly and cannot be flicked".
+ */
+let scrollClaimHandler = null;
+// The handler that is actually registered: a re-install replaces `scrollClaimHandler`,
+// and removing by the new reference would leave the old listener in place forever.
+let attachedClaimHandler = null;
+function attachScrollClaim() {
+    if (attachedClaimHandler !== null || scrollClaimHandler === null)
+        return;
+    attachedClaimHandler = scrollClaimHandler;
+    document.addEventListener('touchmove', attachedClaimHandler, { capture: true, passive: false });
+}
+function detachScrollClaim() {
+    if (attachedClaimHandler === null)
+        return;
+    document.removeEventListener('touchmove', attachedClaimHandler, { capture: true });
+    attachedClaimHandler = null;
+}
 /** Forget stroke state (called on cancel / visibility change / blur). */
